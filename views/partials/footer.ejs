<script type="text/javascript">
    (function () {
        var container = document.querySelector('.js-ec-wa');

        if (!container) {
            return;
        }

        var botao = container.querySelector('.js-ec-wa-botao');
        var painel = container.querySelector('.js-ec-wa-painel');

        if (!botao || !painel) {
            return;
        }

        var listaVendedoras = container.querySelector('.js-ec-wa-vendedoras');

        if (listaVendedoras) {
            var vendedoras = Array.prototype.slice.call(
                listaVendedoras.querySelectorAll('.ec-wa__opcao')
            );

            if (vendedoras.length > 1) {
                for (var i = vendedoras.length - 1; i > 0; i--) {
                    var j = Math.floor(Math.random() * (i + 1));
                    var trocaTemporaria = vendedoras[i];
                    vendedoras[i] = vendedoras[j];
                    vendedoras[j] = trocaTemporaria;
                }

                for (var k = 0; k < vendedoras.length; k++) {
                    listaVendedoras.appendChild(vendedoras[k]);
                }
            }
        }

        var mensagemBase = 'Olá! Vim pelo site da Estilo Canela.';
        var ehHome = window.location.pathname === '/' || window.location.pathname === '';

        if (!ehHome) {
            var mensagemComPagina = mensagemBase + ' Estava vendo esta página: ' + window.location.href;
            var links = container.querySelectorAll('.ec-wa__opcao');

            for (var n = 0; n < links.length; n++) {
                var numero = links[n].getAttribute('href').split('?')[0];
                links[n].setAttribute(
                    'href',
                    numero + '?text=' + encodeURIComponent(mensagemComPagina)
                );
            }
        }

        function abrirPainel() {
            painel.setAttribute('data-aberto', 'true');
            botao.setAttribute('aria-expanded', 'true');
            botao.setAttribute('aria-label', 'Fechar opções de atendimento por WhatsApp');
        }

        function fecharPainel() {
            painel.setAttribute('data-aberto', 'false');
            botao.setAttribute('aria-expanded', 'false');
            botao.setAttribute('aria-label', 'Abrir opções de atendimento por WhatsApp');
        }

        function painelEstaAberto() {
            return painel.getAttribute('data-aberto') === 'true';
        }

        botao.addEventListener('click', function (evento) {
            evento.stopPropagation();

            if (painelEstaAberto()) {
                fecharPainel();
            } else {
                abrirPainel();
            }
        });

        document.addEventListener('click', function (evento) {
            if (painelEstaAberto() && !container.contains(evento.target)) {
                fecharPainel();
            }
        });

        document.addEventListener('keydown', function (evento) {
            if (evento.key === 'Escape' && painelEstaAberto()) {
                fecharPainel();
                botao.focus();
            }
        });

        painel.addEventListener('click', function (evento) {
            var opcao = evento.target.closest('.ec-wa__opcao');

            if (opcao) {
                evento.preventDefault();
                evento.stopPropagation();
                window.alert('Todas as atendentes estão ocupadas no momento. Aguarde 15 minutos para tentar novamente.');
            }
        });
    })();
</script>

