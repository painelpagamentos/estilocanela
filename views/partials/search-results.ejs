<% var money = function(v) { return 'R$ ' + Number(v).toFixed(2).replace('.', ','); }; %>
<% if (results.length > 0) { %>
    <div class="js-search-suggest-item search-suggest-item">
    <div class="search-suggest-list-item">
    <div class="js-search-results-list-item row">
    <p class="search-suggest-category h5 mb-1 text-center col-12">
        Produtos
    </p>
    <% results.forEach(function(p) { %>
        <% var img = p.images && p.images.length ? p.images[0].src : ''; %>
        <div class="swiper-slide">
        <div class="js-item-product js-item-slide p-0 item item-product grid-item">
            <div class="js-product-container position-relative">
                <div class="js-product-item-image-container product-item-image-container item-image">
                    <div style="padding-bottom: 150%;" class="position-relative d-block">
                        <a href="/produtos/<%= p.handle %>/" title="<%= p.title %>" aria-label="<%= p.title %>" class="js-product-item-image-link">
                            <% if (img) { %>
                            <img width="1600" height="2400" src="<%= img %>" class="product-item-image js-item-image fade-in img-absolute img-absolute-centered product-item-image-featured item-image-featured" alt="<%= p.title %>" />
                            <% } %>
                            <div class="placeholder-fade"></div>
                        </a>
                    </div>
                </div>
                <div class="js-item-description item-description">
                    <a href="/produtos/<%= p.handle %>/" title="<%= p.title %>" aria-label="<%= p.title %>" class="item-link">
                        <div class="js-item-name item-name mb-2"><%= p.title %></div>
                        <div class="js-item-price-container item-price-container mb-2">
                            <% var searchPriceDisplay = (p.ec && p.ec.priceDisplay) ? p.ec.priceDisplay : Number(p.price).toFixed(2).replace('.', ','); %>
                            <% var searchCompareDisplay = (p.ec && p.ec.comparePriceDisplay) ? p.ec.comparePriceDisplay : (p.compareAtPrice ? Number(p.compareAtPrice).toFixed(2).replace('.', ',') : ''); %>
                            <% if (searchCompareDisplay) { %>
                            <span class="price-compare">R$<%= searchCompareDisplay %></span>
                            <% } %>
                            <span class="js-price-display item-price">R$<%= searchPriceDisplay %></span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        </div>
    <% }) %>
    </div>
    </div>
    <div class="divider mt-2 mb-2"></div>
    <button class="js-search-suggest-all-link search-suggest-all-link btn btn-primary btn-block mb-2" type="submit">
        Ver todos os resultados
    </button>
    </div>
<% } else { %>
    <div class="js-search-suggest-item search-suggest-item">
        <p class="h5 mb-1 text-center col-12">Nenhum resultado encontrado</p>
    </div>
<% } %>