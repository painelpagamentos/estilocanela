<div class="js-nubesdk-slot" data-nubesdk-slot="before_main_content"></div>

<!-- Faixa de anúncios rolante acima do cabeçalho -->
<div class="ec-topbar" role="banner" aria-label="Benefícios da loja">
    <div class="ec-topbar__track">
        <span class="ec-topbar__text">FRETE GRÁTIS EM COMPRAS ACIMA DE R$ 99,99</span>
        <span class="ec-topbar__text">PRIMEIRA TROCA GRÁTIS</span>
        <span class="ec-topbar__text">CASHBACK EM TODAS AS COMPRAS</span>
        <span class="ec-topbar__text">FRETE GRÁTIS EM COMPRAS ACIMA DE R$ 99,99</span>
        <span class="ec-topbar__text">PRIMEIRA TROCA GRÁTIS</span>
        <span class="ec-topbar__text">CASHBACK EM TODAS AS COMPRAS</span>
        <!-- repetição para loop contínuo -->
        <span class="ec-topbar__text">FRETE GRÁTIS EM COMPRAS ACIMA DE R$ 99,99</span>
        <span class="ec-topbar__text">PRIMEIRA TROCA GRÁTIS</span>
        <span class="ec-topbar__text">CASHBACK EM TODAS AS COMPRAS</span>
        <span class="ec-topbar__text">FRETE GRÁTIS EM COMPRAS ACIMA DE R$ 99,99</span>
        <span class="ec-topbar__text">PRIMEIRA TROCA GRÁTIS</span>
