        <style>
    .ec-wa {
        --ec-wa-botao: #25D366;
        --ec-wa-fundo: #fbfaf6;
        --ec-wa-hover: #f1f1ec;
        --ec-wa-texto: #423e3e;
        --ec-wa-apoio: #484343;
        --ec-wa-borda: #f1f1ec;
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 900;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .ec-wa__painel {
        width: 280px;
        max-width: calc(100vw - 32px);
        background: var(--ec-wa-fundo);
        border: 1px solid var(--ec-wa-borda);
        border-radius: 4px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        overflow: hidden;
        display: none;
    }

    .ec-wa__painel[data-aberto="true"] {
        display: block;
    }

    .ec-wa__intro {
        padding: 18px 20px 14px;
        border-bottom: 1px solid var(--ec-wa-borda);
    }

    .ec-wa__titulo {
        margin: 0 0 6px;
        font-size: 15px;
        font-weight: 700;
        color: var(--ec-wa-texto);
        line-height: 1.3;
    }

    .ec-wa__descricao {
        margin: 0;
        font-size: 13px;
        color: var(--ec-wa-apoio);
        line-height: 1.5;
    }

    .ec-wa__opcao {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--ec-wa-borda);
        text-decoration: none;
        color: var(--ec-wa-texto);
        transition: background-color 0.15s ease;
    }

    .ec-wa__opcao:last-child {
        border-bottom: none;
    }

    .ec-wa__opcao:hover,
    .ec-wa__opcao:focus-visible {
        background-color: var(--ec-wa-hover);
        text-decoration: none;
        color: var(--ec-wa-texto);
    }

    .ec-wa__icone-opcao {
        flex: 0 0 auto;
        width: 22px;
        height: 22px;
        fill: var(--ec-wa-apoio);
    }

    .ec-wa__nome {
        display: block;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
    }

    .ec-wa__funcao {
        display: block;
        font-size: 12px;
        color: var(--ec-wa-apoio);
        line-height: 1.4;
        margin-top: 2px;
    }

    .ec-wa__botao {
        width: 56px;
        height: 56px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background-color: var(--ec-wa-botao);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease;
    }

    .ec-wa__botao:hover {
        transform: scale(1.05);
    }

    .ec-wa__botao:focus-visible {
        outline: 2px solid var(--ec-wa-texto);
        outline-offset: 3px;
    }

    .ec-wa__icone-botao {
        width: 30px;
        height: 30px;
        fill: #ffffff;
        pointer-events: none;
    }

    .ec-wa__fechar {
        display: none;
        width: 18px;
        height: 18px;
        pointer-events: none;
    }

    .ec-wa__botao[aria-expanded="true"] .ec-wa__icone-botao {
        display: none;
    }

    .ec-wa__botao[aria-expanded="true"] .ec-wa__fechar {
        display: block;
    }

    @media (prefers-reduced-motion: reduce) {
        .ec-wa__botao,
        .ec-wa__opcao {
            transition: none;
        }

        .ec-wa__botao:hover {
            transform: none;
        }
    }
    </style>
</head>
