<% ecProduct = ecPrepare(product) %>
<%- include('../partials/head', { ecTitle: ecProduct.title + ' - Estilo Canela Shop', ecOgDescription: (ecProduct.description || '').slice(0, 160), ecBodyClass: ' template-product' }) %>
<%- include('../partials/pre-header', { ecBodyClass: ' template-product' }) %>
<%- include('../partials/header') %>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="breadcrumbs  mb-0 mb-md-2">
                <a class="crumb" href="/">Início</a>
                <span class="separator">.</span>
                <% var ecFirstCollection = (product.collections && product.collections.length) ? product.collections[0] : ''; %>
                <% if (ecFirstCollection) { %>
                <a class="crumb" href="/roupas/<%= ecFirstCollection %>/" title="<%= ecFirstCollection %>"><%= ecFirstCollection %></a>
                <span class="separator">.</span>
                <% } %>
                <span class="crumb active"><%= ecProduct.title %></span>
            </div>
        </div>
    </div>

    <div class="row section-single-product" data-store="product-detail">
        <div class="col-12 col-md-8 pl-md-0">
            <div class="row" data-store="product-image">
                <div class="col-2 d-none d-md-block">
                    <% (product.images || []).slice(0, 5).forEach(function (img, idx) { %>
                    <a href="#" class="js-product-thumb product-thumb d-block position-relative mb-3 <%= idx === 0 ? 'selected' : '' %>" style="padding-bottom: 150%;" data-thumb-loop="<%= idx %>">
                        <img data-sizes="auto" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-srcset="<%= img.src %> 480w, <%= img.src %> 640w" class="img-absolute img-absolute-centered lazyautosizes lazyload" alt="<%= ecProduct.title %>" />
                    </a>
                    <% }); %>
                </div>
                <div class="product-image-container col-12 col-md-10 p-0">
                    <div class="js-swiper-product swiper-container" data-product-images-amount="<%= (product.images || []).length %>">
                        <div class="labels js-labels-floating-group labels-product-slider" data-store="product-item-labels">
                            <% if (ecProduct.comparePrice) { %>
                            <div class="js-offer-label label js-offer-label label label-accent" data-store="product-item-offer-label">
                                <span class="label-offer-percentage"><span class="js-offer-percentage"><%= Math.round((1 - ecProduct.price / ecProduct.comparePrice) * 100) %></span>%</span>
                                <span class="label-offer-percentage-text"> OFF</span>
                            </div>
                            <% } %>
                            <div class="js-shipping-label js-free-shipping-minimum-label label label label-accent" data-store="product-item-label-shipping" data-promotion-type="free-shipping" style="display: none;">Frete grátis</div>
                        </div>
                        <div class="swiper-wrapper">
                            <% (product.images || []).forEach(function (img, idx) { %>
                            <div class="js-product-slide swiper-slide slider-slide" data-image-position="<%= idx %>">
                                <a href="<%= img.src %>" data-fancybox="product-gallery" class="js-product-slide-link d-block position-relative" style="padding-bottom: 150%;">
                                    <img fetchpriority="<%= idx === 0 ? 'high' : 'low' %>" <%= idx === 0 ? 'src="' + img.src + '"' : 'data-src="' + img.src + '"' %>
                                        srcset="<%= img.src %> 480w, <%= img.src %> 640w, <%= img.src %> 1024w"
                                        class="js-product-slide-img product-slider-image img-absolute img-absolute-centered <%= idx === 0 ? '' : 'lazyautosizes lazyload' %>"
                                        data-sizes="auto"
                                        width="1600" height="2400" alt="<%= ecProduct.title %>" />
                                </a>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <section class="page-header pt-4" data-store="page-title">
                <h1 class="js-product-name h4" data-store="product-name-<%= ecProduct.id %>"><%= ecProduct.title %></h1>
            </section>

            <div class="js-price-container price-container mb-3 row" data-store="product-price-<%= ecProduct.id %>">
                <div class="col">
                    <span class="d-inline-block">
                        <div id="compare_price_display" class="js-compare-price-display price-compare" style="display: <%= ecProduct.comparePrice ? 'block' : 'none' %>;" data-price-compare="<%= ecProduct.comparePrice %>">
                            R$<%= ecProduct.comparePriceDisplay %>
                        </div>
                    </span>
                    <span class="d-inline-flex align-items-center">
                        <div class="js-price-display" id="price_display" data-product-price="<%= ecProduct.price %>">R$<%= ecProduct.priceDisplay %></div>
                    </span>
                </div>
                <div class="col-auto">
                    <div class="js-max-installments-container js-max-installments item-installments">
                        <div class="js-max-installments product-installments installment-no-interest">
                            <span class='js-installment-amount product-installment-amount'><%= ecProduct.installments.amount %></span>
                            <span>x de</span>
                            <span class='js-installment-price product-installment-value'>R$<%= ecProduct.installments.value %></span>
                            <span>sem juros</span>
                        </div>
                    </div>
                </div>
            </div>

            <form id="product_form" class="js-product-form" method="post" action="/comprar/" data-store="product-form-<%= ecProduct.id %>">
                <input type="hidden" name="add_to_cart" value="<%= ecProduct.id %>" />
                <div class="js-product-variants form-row pt-2" data-store="product-variants-<%= ecProduct.id %>" data-variants="<%= ecProduct.variantsJson %>" data-product-id="<%= ecProduct.id %>" data-product-handle="<%= ecProduct.handle %>">
                    <% ecProduct.variants.forEach(function (ecVariant, ecVariantIndex) { %>
                    <div class="js-product-variants-group<%= ecVariantIndex === 0 ? ' js-color-variants-container' : '' %> col-12 <%= ecProduct.variants.length > 1 ? 'col-md-6' : '' %>" data-variation-id="<%= ecVariantIndex %>">
                        <div class="form-group">
                            <label class="form-label" for="variation_<%= ecVariantIndex + 1 %>"><%= ecVariant.name %></label>
                            <select id="variation_<%= ecVariantIndex + 1 %>" class="form-select js-variation-option js-refresh-installment-data" name="variation[<%= ecVariantIndex %>]">
                                <% ecVariant.options.forEach(function (ecOption, ecOptionIndex) { %>
                                <option value="<%= ecOption %>" <%= ecOptionIndex === 0 ? 'selected="selected"' : '' %>><%= ecOption %></option>
                                <% }); %>
                            </select>
                            <div class="form-select-icon">
                                <svg class="icon-inline icon-w-14 icon-lg icon-rotate-90"><use xlink:href="#chevron"/></svg>
                            </div>
                        </div>
                    </div>
                    <% }); %>

                    <div class="col-12 mb-3">
                        <% if (ecProduct.inStock) { %>
                        <input type="submit" class="js-addtocart js-prod-submit-form btn btn-primary btn-block mb-4 cart" value="Comprar" data-store="product-buy-button" data-component="product.add-to-cart" />
                        <% } else { %>
                        <input type="button" class="btn btn-secondary btn-block mb-4 cart" value="Esgotado" data-store="product-buy-button" disabled />
                        <% } %>

                        <div class="js-addtocart js-addtocart-placeholder btn btn-primary btn-block btn-transition mb-4 disabled" style="display: none;">
                            <div class="d-inline-block">
                                <span class="js-addtocart-text">Comprar</span>
                                <span class="js-addtocart-success transition-container">Pronto!</span>
                                <div class="js-addtocart-adding js-addtocart-adding-text transition-container">Incluindo...</div>
                            </div>
                        </div>
                    </div>
                    <a href="#" data-toggle="#size-guide-modal" class="js-modal-open btn-link font-small col-12 mb-3">
                        <svg class="icon-inline icon-lg svg-icon-text mr-1"><use xlink:href="#ruller"/></svg>
                        Guia de medidas
                    </a>
                </div>
            </form>

        </div>
    </div>

    <% if (product.description) { %>
    <div id="product-description" class="mt-4 col-12 p-0 px-md-3" data-store="product-description-<%= ecProduct.id %>">
        <div class="js-nubesdk-slot" data-nubesdk-slot="before_product_description"></div>
        <div class="product-description user-content">
            <%- product.description %>
        </div>
        <div class="js-nubesdk-slot" data-nubesdk-slot="after_product_description"></div>
    </div>
    <% } %>

    <div id="size-guide-modal" class="js-modal modal modal-bottom-md modal-right modal--md transition-slide modal-centered transition-soft" style="display: none;">
        <div class="js-modal-close modal-header">
            <div class="row">
                <div class="col offset-2 text-center">Guia de medidas</div>
                <div class="col-2 text-right">
                    <a href="#" class="js-modal-close" aria-label="Fechar guia de medidas">
                        <svg class="icon-inline icon-lg svg-icon-text"><use xlink:href="#times"/></svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="modal-body">
            <div class="user-content">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <% ecProduct.measurementGuide.headers.forEach(function (header) { %>
                                <th><%= header %></th>
                                <% }); %>
                            </tr>
                        </thead>
                        <tbody>
                            <% ecProduct.measurementGuide.rows.forEach(function (row) { %>
                            <tr>
                                <% row.forEach(function (value) { %><td><%= value %></td><% }); %>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <p><%= ecProduct.measurementGuide.note %></p>
            </div>
        </div>
    </div>
    <div class="js-modal-overlay modal-overlay" data-modal-id="#size-guide-modal" style="display: none;"></div>

    <% if (typeof relatedProducts !== 'undefined' && relatedProducts.length) { %>
    <section id="related-products" class="products-section js-related-products section-products-related position-relative mb-3" data-store="related-products" data-component="related-products" data-related-amount="<%= relatedProducts.length %>">
        <div class="position-relative">
            <div class="products-section-title-container section-title text-center">
                <h2 class="products-section-title h5 mb-1">Produtos similares</h2>
            </div>
            <div class="products-section-container">
                <div class="products-section-slider-container js-swiper-related swiper-container">
                    <div class="products-section-slider-wrapper swiper-wrapper">
                        <% relatedProducts.forEach(function (rp) { var ecProduct = ecPrepare(rp); %>
                        <div class="swiper-slide">
                            <%- include('../partials/product-item.ejs', { ecProduct: ecProduct }) %>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <div class="products-section-prev-container js-swiper-related-prev swiper-button-prev d-none d-md-block svg-square svg-icon-text">
                    <svg class="products-section-slider-control products-section-slider-control-prev icon-inline icon-lg icon-flip-horizontal"><use xlink:href="#chevron"/></svg>
                </div>
                <div class="products-section-next-container js-swiper-related-next swiper-button-next d-none d-md-block svg-square svg-icon-text">
                    <svg class="products-section-slider-control products-section-slider-control-next icon-inline icon-lg"><use xlink:href="#chevron"/></svg>
                </div>
            </div>
        </div>
    </section>
    <% } %>
</div>

<script type="text/javascript">
    // ------------------------------------------------------------
    // Página de produto: variantes + adicionar ao carrinho (Corvex)
    // ------------------------------------------------------------
    document.addEventListener('DOMContentLoaded', function () {
        var container = document.querySelector('.js-product-variants');
        if (!container) return;

        var ecProductData = {
            id: '<%= ecProduct.id %>',
            handle: '<%= ecProduct.handle %>',
            title: <%- JSON.stringify(ecProduct.title) %>,
            image: '<%= (product.images && product.images[0] && product.images[0].src) || '' %>'
        };

        var raw = container.getAttribute('data-variants');
        var data = { variants: [] };
        try { data = JSON.parse(raw); } catch (e) {}
        var quickshopVariants = data.variants || [];

        var priceDisplay = document.getElementById('price_display');
        var compareDisplay = document.getElementById('compare_price_display');
        var installmentValue = document.querySelector('.js-installment-price.product-installment-value');
        var sw = document.querySelector('.js-swiper-product.swiper-container');

        function ecSelectedOptions() {
            var out = [];
            document.querySelectorAll('#product_form .js-variation-option').forEach(function (sel) { out.push(sel.value); });
            return out;
        }

        function ecFindVariant(selected) {
            return quickshopVariants.find(function (v) {
                var opts = (v.options || []).map(String);
                return selected.every(function (s) { return opts.indexOf(String(s)) >= 0; });
            }) || quickshopVariants[0];
        }

        function ecFormatPrice(cents) {
            return 'R$' + (cents / 100).toFixed(2).replace('.', ',');
        }

        function ecUpdateFromVariant(variant) {
            if (!variant) return;
            var cents = Math.round((Number(variant.price) || 0) * 100);
            if (priceDisplay) {
                priceDisplay.textContent = ecFormatPrice(cents);
                priceDisplay.dataset.productPrice = cents;
            }
            if (installmentValue) {
                installmentValue.textContent = ecFormatPrice(Math.floor(cents / 8));
            }
            // troca a imagem do slider conforme a variante
            if (variant.image && sw) {
                var slides = sw.querySelectorAll('.js-product-slide');
                for (var i = 0; i < slides.length; i++) {
                    var img = slides[i].querySelector('.js-product-slide-img');
                    var link = slides[i].querySelector('.js-product-slide-link');
                    if (img && img.getAttribute('srcset').indexOf(variant.image) >= 0) {
                        if (link) link.setAttribute('data-fancybox', 'product-gallery');
                        if (window.productsProductSwiper) window.productsProductSwiper.slideTo(i, 0);
                        break;
                    }
                }
            }
            // id da variante para o form
            var form = document.getElementById('product_form');
            if (form) form.dataset.variantId = variant.id;
        }

        document.querySelectorAll('#product_form .js-variation-option').forEach(function (sel) {
            sel.addEventListener('change', function () {
                ecUpdateFromVariant(ecFindVariant(ecSelectedOptions()));
            });
        });

        // estado inicial
        ecUpdateFromVariant(ecFindVariant(ecSelectedOptions()));

        // adicionar ao carrinho via YBCart + Corvex checkout
        var form = document.getElementById('product_form');
        if (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!window.YBCart) return;

                var variant = ecFindVariant(ecSelectedOptions());
                if (!variant) return;
                var button = form.querySelector('input.js-addtocart');
                var placeholder = form.querySelector('.js-addtocart-placeholder');
                var btnText = placeholder ? placeholder.querySelector('.js-addtocart-text') : null;
                var btnAdding = placeholder ? placeholder.querySelector('.js-addtocart-adding') : null;

                if (button) button.style.display = 'none';
                if (placeholder) placeholder.style.display = 'inline-block';
                if (btnText) btnText.style.display = 'none';
                if (btnAdding) btnAdding.classList.add('active');

                function restore() {
                    if (btnAdding) btnAdding.classList.remove('active');
                    if (btnText) btnText.style.display = '';
                    if (placeholder) placeholder.style.display = 'none';
                    if (button) button.style.display = '';
                }

                try {
                    YBCart.add(
                        { id: String(ecProductData.id), handle: ecProductData.handle, title: ecProductData.title },
                        {
                            id: String(variant.id),
                            title: (variant.options || []).join(', ') || variant.title || '',
                            price: Number(variant.price) || 0,
                            image: variant.image || ecProductData.image || ''
                        },
                        1
                    );
                } catch (err) {
                    restore();
                    return;
                }

                // notificação do tema + abre o modal do carrinho
                setTimeout(function () {
                    restore();
                    var imgSrc = (variant.image || ecProductData.image || '');
                    document.querySelectorAll('.js-cart-notification-item-img').forEach(function (el) {
                        el.setAttribute('srcset', imgSrc);
                        el.setAttribute('src', imgSrc);
                    });
                    document.querySelectorAll('.js-cart-notification-item-name').forEach(function (el) {
                        el.textContent = ecProductData.title;
                    });
                    document.querySelectorAll('.js-cart-notification-item-quantity').forEach(function (el) {
                        el.textContent = 1;
                    });
                    document.querySelectorAll('.js-cart-notification-item-price').forEach(function (el) {
                        el.textContent = ecFormatPrice(Math.round((Number(variant.price) || 0) * 100));
                    });
                    if (typeof modalOpen === 'function') modalOpen('#modal-cart');
                }, 300);
            });
        }

        // thumbs da galeria trocam o slide
        document.querySelectorAll('.js-product-thumb').forEach(function (thumb) {
            thumb.addEventListener('click', function (e) {
                e.preventDefault();
                var idx = parseInt(this.getAttribute('data-thumb-loop'), 10) || 0;
                document.querySelectorAll('.js-product-thumb').forEach(function (t) { t.classList.remove('selected'); });
                this.classList.add('selected');
                if (window.productsProductSwiper) window.productsProductSwiper.slideTo(idx, 0);
            });
        });
    });

    // swiper do produto
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof createSwiper === 'function') {
            createSwiper('.js-swiper-product', {
                lazy: true,
                watchOverflow: true,
                pagination: { el: '.js-swiper-product-pagination', clickable: true },
                navigation: { nextEl: '.js-swiper-product-next', prevEl: '.js-swiper-product-prev' },
                slidesPerView: 1
            }, function (swiperInstance) {
                window.productsProductSwiper = swiperInstance;
            });
        }
    });
</script>

<%- include('../partials/footer') %>
<%- include('../partials/modals') %>
