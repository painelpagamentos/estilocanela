<%- include('../partials/head', { ecTitle: typeof ecTitle !== 'undefined' ? ecTitle : '' , ecBodyClass: ' template-collection' }) %>
<%- include('../partials/pre-header', { ecBodyClass: ' template-collection' }) %>
<%- include('../partials/header') %>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="col-12 col-md mb-4">
                <div class="breadcrumbs  mb-0 mb-md-2">
                    <a href="/" class="crumb">Início</a> > <span class="crumb"><%= collectionTitle %></span>
                </div>
                <section class="page-header  " data-store="page-title">
                    <h1 class="h4"><%= collectionTitle %></h1>
                </section>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col pl-0" data-store="category-grid-<%= handle %>">
            <div class="js-product-table row">
                <div class="last-page" style="display:none;"></div>
                <% if (typeof products !== 'undefined' && products.length) { %>
                    <% products.forEach(function (ecProduct) { %>
                        <% ecProduct = ecPrepare(ecProduct) %>
                        <%- include('../partials/product-item.ejs', { ecProduct: ecProduct, layout: 'grid' }) %>
                    <% }); %>
                <% } else { %>
                    <div class="col-12">
                        <div class="alert alert-info">Não há produtos nesta categoria.</div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="row">
        <div class="col-12 text-center py-4">
            <div class="js-products-pagination text-center">
                <ul class="pagination d-inline-flex mb-0">
                    <% if (currentPage > 1) { %>
                        <li><a class="btn btn-secondary btn-small mr-2" href="?page=<%= currentPage - 1 %>">Anterior</a></li>
                    <% } %>
                    <% for (var p = 1; p <= totalPages; p++) { %>
                        <li class="<%= p === currentPage ? 'active' : '' %>">
                            <a class="btn btn-small <%= p === currentPage ? 'btn-primary' : 'btn-secondary' %> mr-1" href="?page=<%= p %>"><%= p %></a>
                        </li>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <li><a class="btn btn-secondary btn-small ml-2" href="?page=<%= currentPage + 1 %>">Próxima</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/modals') %>
