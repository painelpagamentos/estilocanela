<%- include('../partials/head', { ecTitle: typeof ecTitle !== 'undefined' ? ecTitle : '' , ecBodyClass: ' template-search' }) %>
<%- include('../partials/pre-header', { ecBodyClass: ' template-search' }) %>
<%- include('../partials/header') %>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="breadcrumbs  mb-0 mb-md-2">
                <a href="/" class="crumb">Início</a> > <span class="crumb">Busca</span>
            </div>
            <section class="page-header  " data-store="page-title">
                <h1 class="h4">Busca: "<%= query %>"</h1>
            </section>
            <div class="divider mb-4"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-12" data-store="search-grid">
            <div class="js-product-table row">
                <% if (products.length) { %>
                    <% products.forEach(function (ecProduct) { %>
                        <% ecProduct = ecPrepare(ecProduct) %>
                        <%- include('../partials/product-item.ejs', { ecProduct: ecProduct, layout: 'grid' }) %>
                    <% }); %>
                <% } else { %>
                    <div class="col-12">
                        <div class="alert alert-info">Nenhum produto encontrado para "<%= query %>".</div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/modals') %>
