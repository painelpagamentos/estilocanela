<%- include('../partials/head', { ecTitle: typeof ecTitle !== 'undefined' ? ecTitle : '' , ecBodyClass: ' template-cart' }) %>
<%- include('../partials/pre-header', { ecBodyClass: ' template-cart' }) %>
<%- include('../partials/header') %>

<div class="container">
    <div class="row">
        <div class="col-12">
            <section class="page-header  pt-4" data-store="page-title">
                <h1 class="h4">Carrinho de Compras</h1>
            </section>
            <div class="divider"></div>
            <div id="ec-cart-page">
                <div class="js-ajax-cart-list cart-row"></div>
                <div class="js-empty-ajax-cart cart-row">
                    <div class="alert alert-info" data-component="cart.empty-message">O carrinho de compras está vazio.</div>
                    <a href="/roupas/" class="btn btn-primary btn-medium mb-4">Ver produtos</a>
                </div>
                <div class="js-visible-on-cart-filled" style="display:none;">
                    <div class="cart-totals-container mb-4">
                        <div class="cart-subtotal h5 font-big font-weight-normal mb-1 row" data-store="cart-subtotal">
                            <span class="cart-subtotal-label col ">Subtotal (sem frete):</span>
                            <span class="js-ajax-cart-total js-cart-subtotal cart-subtotal-price col-auto text-right" data-priceraw="0">R$0,00</span>
                        </div>
                        <div class="cart-total h4 row font-large mb-0">
                            <span class="cart-total-label col">Total:</span>
                            <strong class="js-cart-total cart-total-price col text-right">R$0,00</strong>
                        </div>
                    </div>
                    <div class="mb-4">
                        <a href="#" class="js-ec-page-checkout btn btn-primary btn-block btn-medium">Iniciar Compra</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        // Renderiza o carrinho na página (mesma estrutura do modal-cart)
        var cart = window.YBCart ? YBCart.getCart() : { items: [] };
        var items = cart.items || [];

        var list = document.querySelector('#ec-cart-page .js-ajax-cart-list');
        var empty = document.querySelector('#ec-cart-page .js-empty-ajax-cart');
        var filled = document.querySelectorAll('#ec-cart-page .js-visible-on-cart-filled');
        var totals = document.querySelectorAll('#ec-cart-page .js-cart-total');
        var subtotals = document.querySelectorAll('#ec-cart-page .js-cart-subtotal');
        var subtotal = 0;

        if (list) {
            list.innerHTML = items.map(function (it) {
                var v = it.variant || {};
                var p = it.product || {};
                var price = Math.round((Number(v.price) || 0) * 100);
                subtotal += price * (parseInt(it.quantity, 10) || 1);
                return [
                    '<div class="js-cart-item cart-item row">',
                    '    <div class="col-12 col-md-6 d-flex align-items-center">',
                    '        <img src="' + String(v.image || '') + '" alt="' + String(p.title || '') + '" class="js-cart-item-img cart-item-img img-fluid mr-3" style="width: 80px;">',
                    '        <div class="cart-item-details">',
                    '            <div class="js-cart-item-name cart-item-name mb-1">' + String(p.title || '') + '</div>',
                    '            <div class="js-cart-item-variant cart-item-variant font-small mb-2">' + String(v.title || '') + '</div>',
                    '            <div class="js-cart-item-price cart-item-price mb-1">' + ecFormatPrice(price) + '</div>',
                    '        </div>',
                    '    </div>',
                    '    <div class="col-6 col-md-3 d-flex align-items-center">',
                    '        <div class="js-cart-quantity-input-row">',
                    '            <button type="button" class="js-cart-quantity-btn" data-variant-id="' + String(v.id) + '" data-delta="-1" aria-label="Diminuir quantidade">–</button>',
                    '            <input type="tel" value="' + (parseInt(it.quantity, 10) || 1) + '" class="js-cart-quantity-input" data-variant-id="' + String(v.id) + '" aria-label="Quantidade">',
                    '            <button type="button" class="js-cart-quantity-btn" data-variant-id="' + String(v.id) + '" data-delta="1" aria-label="Aumentar quantidade">+</button>',
                    '        </div>',
                    '    </div>',
                    '    <div class="col-6 col-md-3 text-right d-flex align-items-center justify-content-end">',
                    '        <span class="js-cart-item-line-price">' + ecFormatPrice(price * (parseInt(it.quantity, 10) || 1)) + '</span>',
                    '        <a href="#" class="js-remove-item ml-3" data-variant-id="' + String(v.id) + '" aria-label="Remover produto">',
                    '            <svg class="icon-inline svg-icon-text icon-md"><use xlink:href="#trash-alt"/></svg>',
                    '        </a>',
                    '    </div>',
                    '</div>'
                ].join('');
            }).join('');
        }

        if (empty) empty.style.display = items.length ? 'none' : 'block';
        filled.forEach(function (el) { el.style.display = items.length ? 'block' : 'none'; });
        totals.forEach(function (el) { el.textContent = ecFormatPrice(subtotal); });
        subtotals.forEach(function (el) { el.textContent = ecFormatPrice(subtotal); });

        // Checkout Corvex a partir da página do carrinho
        var checkout = document.querySelector('.js-ec-page-checkout');
        if (checkout) {
            checkout.addEventListener('click', async function (e) {
                e.preventDefault();
                var cartNow = YBCart.getCart();
                if (!(cartNow.items || []).length) return;
                checkout.disabled = true;
                checkout.textContent = 'Processando...';
                try {
                    var resp = await fetch('/api/checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ items: cartNow.items })
                    });
                    var data = await resp.json().catch(function () { return null; });
                    if (!resp.ok || !data || !data.success || !data.checkoutUrl) {
                        throw new Error((data && data.error) || 'Não foi possível iniciar o pagamento.');
                    }
                    window.location.href = data.checkoutUrl;
                } catch (err) {
                    checkout.disabled = false;
                    checkout.textContent = 'Iniciar Compra';
                    alert('Erro ao finalizar a compra: ' + err.message);
                }
            });
        }
    });
</script>

<%- include('../partials/footer') %>
<%- include('../partials/modals') %>
