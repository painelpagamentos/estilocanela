<%- include('../partials/head', { ecTitle: typeof ecTitle !== 'undefined' ? ecTitle : '' , ecBodyClass: ' template-thankyou' }) %>
<%- include('../partials/pre-header', { ecBodyClass: ' template-thankyou' }) %>
<%- include('../partials/header') %>

<div class="container">
    <div class="row">
        <div class="col-12 text-center py-5" id="thank-you">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="#4bb98c" stroke-width="1.2" class="mb-4">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>

            <h1 class="h4 mb-3">Obrigado pela sua compra!</h1>

            <p class="font-large mb-1">Seu pedido foi recebido com sucesso.</p>
            <p class="opacity-50 mb-4">
                Você receberá todas as informações do seu pedido, incluindo confirmação de pagamento
                e dados de entrega pelo <strong>e-mail</strong>.
            </p>

            <a href="/" class="btn btn-primary btn-medium">Continuar comprando</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    // Pedido concluído: esvaziar o carrinho local (mesma fonte de verdade)
    (function () {
        function clearCart() {
            if (window.YBCart && typeof YBCart.clear === 'function') {
                YBCart.clear();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', clearCart);
        } else {
            clearCart();
        }
    })();
</script>

<%- include('../partials/footer') %>
<%- include('../partials/modals') %>
